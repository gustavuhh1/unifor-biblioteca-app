# Nomes das variáveis do app (sem valores secretos). Copie para .env e preencha.
# Tudo com prefixo EXPO_PUBLIC_ vai para dentro do app, então nunca ponha segredo aqui.

# Base da API. No emulador Android, o computador é 10.0.2.2.
EXPO_PUBLIC_API_URL=
# "true" liga o Auth emulator do Firebase (e dispensa a configuração web abaixo).
EXPO_PUBLIC_USE_EMULATORS=
# Endereço do Auth emulator (padrão: http://10.0.2.2:9099).
EXPO_PUBLIC_AUTH_EMULATOR_URL=

# Configuração web do Firebase (pública por natureza). Obrigatória fora do emulador.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Assinatura do build de desenvolvimento do Android (keystore fora do repositório).
# O arquivo guarda a chave; só os nomes ficam aqui. Nunca escreva as senhas em arquivos versionados.
UNIBOOKS_KEYSTORE_PATH=
UNIBOOKS_KEYSTORE_PASSWORD=
UNIBOOKS_KEY_ALIAS=
UNIBOOKS_KEY_PASSWORD=
